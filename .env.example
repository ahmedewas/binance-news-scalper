# Binance News Scalper Configuration
# Mode: "PAPER" for safe simulation, "LIVE" for real trades
TRADING_MODE=PAPER

# Binance API Credentials (Only needed for LIVE mode)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Risk & Capital Management
MIN_NOTIONAL=5.0
MAX_SLOTS=5
INITIAL_PAPER_BALANCE=15.0

# Dynamic Triple-Exit Strategy
TRAILING_TP_PCT=0.012
TRAILING_OFFSET_PCT=0.004
STOP_LOSS_PCT=0.009
TIMEOUT_MINUTES=20

# Quantitative Scoring Threshold (0-100)
MIN_PROBABILITY_SCORE=70.0

# Web Dashboard Port
PORT=8080
HOST=127.0.0.1
# Required (24+ characters) for remote access or LIVE. Use HTTPS when hosted.
DASHBOARD_TOKEN=
STATE_DIR=data
MAX_NEWS_AGE_SECONDS=900
MAX_SESSION_LOSS_PCT=0.03
SYMBOL_COOLDOWN_MINUTES=15
MAX_ENTRIES_PER_HOUR=6
# Quantitative flow breakouts and volume decay protection
ENABLE_FLOW_ENTRIES=true
ENABLE_VOLUME_DECAY_EXIT=true
